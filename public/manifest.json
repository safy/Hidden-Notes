{
  "manifest_version": 3,
  "name": "Hidden Notes",
  "version": "1.0.0",
  "description": "Create notes with visual hiding of sensitive information",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Hidden Notes",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*",
        "https://npmjs.com/*",
        "https://hub.docker.com/*",
        "https://aws.amazon.com/*",
        "https://console.cloud.google.com/*",
        "https://console.aws.amazon.com/*",
        "https://dashboard.stripe.com/*",
        "https://app.netlify.com/*",
        "https://vercel.com/*",
        "https://heroku.com/*",
        "https://www.digitalocean.com/*",
        "https://linode.com/*"
      ],
      "js": ["src/content-scripts/clipboard-mask.ts"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject-mask.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "unlimitedStorage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": []
}

